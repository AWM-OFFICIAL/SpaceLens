<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- SpaceLens: restrained black / white / cyan. No gradients-as-decoration. -->
  <Color x:Key="BgColor">#FF0A0A0A</Color>
  <Color x:Key="SurfaceColor">#FF111111</Color>
  <Color x:Key="SurfaceElevatedColor">#FF141414</Color>
  <Color x:Key="ChartTrackColor">#FF1C1C1C</Color>
  <Color x:Key="SidebarColor">#FF111111</Color>
  <Color x:Key="BorderColor">#FF2C2C2C</Color>
  <Color x:Key="BorderSoftColor">#FF2C2C2C</Color>
  <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
  <Color x:Key="TextSecondaryColor">#FFD0D0D0</Color>
  <Color x:Key="TextMutedColor">#FFB8B8B8</Color>
  <Color x:Key="AccentColor">#FF00E5FF</Color>
  <Color x:Key="AccentSoftColor">#3300E5FF</Color>
  <Color x:Key="AccentDimColor">#FF00B8CC</Color>
  <Color x:Key="AccentBrightColor">#FF00E5FF</Color>
  <Color x:Key="SafeColor">#FF3DDB9A</Color>
  <Color x:Key="ReviewColor">#FFFFC14D</Color>
  <Color x:Key="DangerColor">#FFFF6B6B</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}"/>
  <SolidColorBrush x:Key="SafeBrush" Color="{StaticResource SafeColor}"/>
  <SolidColorBrush x:Key="ReviewBrush" Color="{StaticResource ReviewColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

  <!-- Quiet welcome wash — almost flat -->
  <SolidColorBrush x:Key="HeroGradient" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="CardFillBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="PrimaryButtonBrush" Color="{StaticResource AccentBrightColor}"/>
  <SolidColorBrush x:Key="AmbientGlowBrush" Color="#00000000"/>
</ResourceDictionary>
