<Window x:Class="SpaceLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SpaceLens.ViewModels"
        xmlns:conv="clr-namespace:SpaceLens.Converters"
        xmlns:ctrl="clr-namespace:SpaceLens.Controls"
        Title="SpaceLens"
        Height="820" Width="1280" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Icon="Assets/logo.ico"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Search"/>
    <KeyBinding Key="Escape" Command="{Binding CloseDetailCommand}"/>
  </Window.InputBindings>
  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>
  <Window.Resources>
    <conv:SizeFormatConverter x:Key="SizeFmt"/>
    <conv:RiskToBrushConverter x:Key="RiskBrush"/>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <conv:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
    <conv:InvertBoolConverter x:Key="InvertBool"/>
    <conv:NullToVisibilityConverter x:Key="NullVis"/>
    <conv:NullToVisibilityConverter x:Key="NullVisInv" Invert="True"/>
    <conv:CategoryIndexBrushConverter x:Key="CatBrush"/>
    <conv:DriveUsageWidthConverter x:Key="DriveRatio"/>
    <conv:NavActiveBrushConverter x:Key="NavBg"/>
    <conv:NavActiveForegroundConverter x:Key="NavFg"/>
    <conv:NavActiveVisibilityConverter x:Key="NavAccentVis"/>
  </Window.Resources>

  <Grid Background="{DynamicResource BgBrush}">
    <!-- Brand cyan top accent line -->
    <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" Panel.ZIndex="30"/>

    <!-- Welcome -->
    <Border Background="{DynamicResource BgBrush}" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolVis}}" Panel.ZIndex="20" Margin="0,2,0,0">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
        <Image Source="Assets/logo.png" Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,20"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="LOCAL STORAGE" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock Text="See what fills your drives." FontSize="28" FontWeight="SemiBold"
                   FontFamily="{StaticResource UiDisplay}"
                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock Text="SpaceLens maps files on this PC only. Nothing is deleted unless you confirm — Recycle Bin by default."
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,0,0,28"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="Scan this PC" Style="{StaticResource PrimaryButton}" Command="{Binding StartWelcomeScanCommand}"
                  ToolTip="Start a full PC storage scan" MinWidth="160" Margin="0,0,10,0"
                  AutomationProperties.Name="Scan this PC"/>
          <Button Content="Choose a folder" Style="{StaticResource GhostButton}" Command="{Binding StartWelcomeFolderScanCommand}"
                  ToolTip="Analyze one folder only" MinWidth="140"
                  AutomationProperties.Name="Choose a folder"/>
        </StackPanel>
        <Button Content="Skip for now" Style="{StaticResource SidebarLinkButton}" Command="{Binding SkipWelcomeCommand}"
                ToolTip="Enter the app without scanning" HorizontalAlignment="Center" Margin="0,16,0,0"
                Foreground="{DynamicResource TextMutedBrush}"
                AutomationProperties.Name="Skip for now"/>
      </StackPanel>
    </Border>

    <Grid Visibility="{Binding ShowWelcome, Converter={StaticResource BoolVisInv}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar: precision instrument rail -->
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- Brand -->
          <StackPanel DockPanel.Dock="Top" Margin="20,22,16,0">
            <DockPanel Margin="0,0,0,22" LastChildFill="False">
              <Image DockPanel.Dock="Left" Source="Assets/icon.png" Width="32" Height="32" Margin="0,0,12,0"
                     RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource UiDisplay}">
                  <Run Text="Space" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <Run Text="Lens" Foreground="{DynamicResource AccentBrush}"/>
                </TextBlock>
                <TextBlock Text="LOCAL STORAGE" FontFamily="{StaticResource MonoFont}" FontSize="9"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>

          <!-- Drive meter -->
          <Border DockPanel.Dock="Top" Margin="16,0,12,0" Padding="12,14"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding PrimaryDrive.Name, StringFormat={}DRIVE  {0}, FallbackValue=DRIVE  C:}"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"
                           Text="{Binding UsedPercent, StringFormat={}{0:0}% USED}"/>
              </DockPanel>
              <TextBlock FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource UiDisplay}" Margin="0,0,0,10">
                <Run Text="{Binding FreeLabel, Mode=OneWay}"/>
                <Run Text=" free" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </TextBlock>
              <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="4" Margin="0,0,0,8"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}">
                <Run Text="{Binding UsedLabel, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding TotalLabel, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>
          </Border>

          <!-- Scan actions -->
          <StackPanel DockPanel.Dock="Top" Margin="16,14,12,8">
            <Button Content="Scan PC" Style="{StaticResource PrimaryButton}" Command="{Binding ScanEntirePcCommand}"
                    ToolTip="Analyze all ready drives" HorizontalAlignment="Stretch" Padding="16,11"/>
            <Button Content="Scan folder…" Style="{StaticResource SidebarLinkButton}" Command="{Binding ScanFolderCommand}"
                    ToolTip="Analyze one folder only" Margin="2,4,0,0"/>
          </StackPanel>

          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" Margin="16,6,12,4"/>

          <!-- Theme footer -->
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                  Padding="16,12,12,16" Margin="0,4,0,0">
            <Button Content="{Binding ThemeActionLabel}" Style="{StaticResource SidebarLinkButton}"
                    Command="{Binding ToggleThemeCommand}"
                    ToolTip="Switch dark / light theme"
                    Foreground="{DynamicResource TextMutedBrush}"/>
          </Border>

          <!-- Nav -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,8,0" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding NavItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Section}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SidebarSectionLabel}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSection}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource NavButton}"
                            AutomationProperties.Name="{Binding Label}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Page}">
                      <Button.Background>
                        <MultiBinding Converter="{StaticResource NavBg}">
                          <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                          <Binding Path="Page"/>
                        </MultiBinding>
                      </Button.Background>
                      <Button.Foreground>
                        <MultiBinding Converter="{StaticResource NavFg}">
                          <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                          <Binding Path="Page"/>
                        </MultiBinding>
                      </Button.Foreground>
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Width="2" Height="14" CornerRadius="1" Margin="0,0,10,0"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                          <Border.Visibility>
                            <MultiBinding Converter="{StaticResource NavAccentVis}">
                              <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                              <Binding Path="Page"/>
                            </MultiBinding>
                          </Border.Visibility>
                        </Border>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                      </DockPanel>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scan progress banner -->
        <Border Grid.Row="0" Background="{DynamicResource AccentSoftBrush}" Padding="16,12" CornerRadius="0"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding ScanPhase}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ScanCurrentPath}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,6"/>
              <ProgressBar Value="{Binding ScanPercent}" Maximum="100"/>
              <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="Indexed "/><Run Text="{Binding ScanFilesIndexed, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" files - "/><Run Text="{Binding ScanBytesLabel, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel scan" Style="{StaticResource GhostButton}" Command="{Binding CancelScanCommand}"
                    ToolTip="Stop the scan in progress" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,22" VerticalScrollBarVisibility="Visible">
          <Grid>
            <!-- Overview -->
            <StackPanel x:Name="OverviewPage">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Overview">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>

              <TextBlock Text="HOME" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock Text="Where space goes" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock Text="Scan once. Explore carefully. Delete only what you confirm."
                         Style="{StaticResource MutedText}" Margin="0,0,0,28"/>

              <ctrl:EmptyStateView
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Nothing mapped yet"
                                   Description="Run a scan to build a local map of this PC. SpaceLens never uploads your files. Cleanup always asks first and prefers the Recycle Bin."
                                   Hint1="After a scan you will see categories, heaviest folders, and SAFE cleanup suggestions here."/>

              <StackPanel Visibility="{Binding HasScanResult, Converter={StaticResource BoolVis}}">
              <!-- Drive story — one primary statement, not a KPI strip -->
              <DockPanel Margin="0,0,0,36" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" MaxWidth="480">
                  <TextBlock Text="PRIMARY DRIVE" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                  <DockPanel LastChildFill="False" Margin="0,0,0,4">
                    <ctrl:RingGauge DockPanel.Dock="Left" Width="72" Height="72" Thickness="5"
                                    Value="{Binding UsedPercent}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock FontSize="40" FontWeight="SemiBold">
                        <Run Text="{Binding FreeLabel, Mode=OneWay}"/>
                      </TextBlock>
                      <TextBlock Text="free on this volume" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                  </DockPanel>
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0">
                    <Run Text="{Binding UsedLabel, Mode=OneWay}"/><Run Text=" used of "/><Run Text="{Binding TotalLabel, Mode=OneWay}"/>
                    <Run Text="  ·  "/><Run Text="{Binding UsedPercent, StringFormat={}{0:0}% occupied, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="24,0,0,0">
                  <TextBlock Text="Potential to free" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                  <TextBlock Text="{Binding PotentialCleanupBytes, Converter={StaticResource SizeFmt}}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                  <Button Content="Review cleanup" Style="{StaticResource LinkButton}" Margin="0,10,0,0"
                          Command="{Binding NavigateCommand}" CommandParameter="Cleanup"
                          HorizontalAlignment="Left"/>
                </StackPanel>
              </DockPanel>

              <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="48"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="CATEGORIES" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16">
                    <Run Text="Total used  "/><Run Text="{Binding UsedLabel, Mode=OneWay}"/>
                  </TextBlock>
                  <ctrl:DonutChart Height="180" Width="180" HorizontalAlignment="Left" Items="{Binding ChartCategories}" Margin="0,0,0,20"/>
                  <ItemsControl ItemsSource="{Binding ChartCategories}" AlternationCount="8">
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,0,8"/>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel>
                          <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Fill="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource CatBrush}}"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Category}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" Margin="0,8"/>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="DISTRIBUTION" Style="{StaticResource CaptionText}" Margin="0,0,0,16"/>
                  <ctrl:BarChart MinHeight="200" Items="{Binding ChartCategories}"/>
                </StackPanel>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="All folders" Style="{StaticResource LinkButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Largest Folders"/>
                    <TextBlock Text="Heaviest folders" FontSize="13" FontWeight="SemiBold"/>
                  </DockPanel>
                  <ListBox ItemsSource="{Binding LargestFolders}" MaxHeight="260"
                           MouseDoubleClick="FolderList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FullPath}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="All files" Style="{StaticResource LinkButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Largest Files"/>
                    <TextBlock Text="Heaviest files" FontSize="13" FontWeight="SemiBold"/>
                  </DockPanel>
                  <ListBox ItemsSource="{Binding LargestFiles}" MaxHeight="260"
                           MouseDoubleClick="FileList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DirectoryPath}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Button Content="Review cleanup" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Cleanup" Margin="0,0,10,0"/>
                <Button Content="Export report" Style="{StaticResource GhostButton}" Command="{Binding ExportReportCommand}"/>
              </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Largest Files -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Largest Files">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <TextBlock DockPanel.Dock="Top" Text="FILES" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock DockPanel.Dock="Top" Text="Largest files" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top" Text="Biggest individual files from your last scan."
                         Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Largest files appear after a scan"
                                   Description="After a scan, this list ranks the largest files so you can open, review, or clean them safely."
                                   Hint1="Filter by size and category once results are ready."/>
              <DockPanel Visibility="{Binding HasScanResult, Converter={StaticResource BoolVis}}">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="SIZE" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                    <ComboBox Width="140" SelectedValue="{Binding SelectedSizeFilter}" SelectedValuePath="Content">
                      <ComboBoxItem Content="All"/>
                      <ComboBoxItem Content=">1GB"/>
                      <ComboBoxItem Content=">5GB"/>
                      <ComboBoxItem Content=">10GB"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="CATEGORY" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                    <ComboBox Width="160" SelectedValue="{Binding SelectedCategoryFilter}" SelectedValuePath="Content">
                      <ComboBoxItem Content="All"/>
                      <ComboBoxItem Content="Videos"/>
                      <ComboBoxItem Content="Images"/>
                      <ComboBoxItem Content="Archives"/>
                      <ComboBoxItem Content="Installers"/>
                      <ComboBoxItem Content="Documents"/>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <ListBox ItemsSource="{Binding LargestFiles}" MouseDoubleClick="FileList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Category}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Risk}" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </DockPanel>
            </DockPanel>

            <!-- Largest Folders -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Largest Folders">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <TextBlock DockPanel.Dock="Top" Text="FOLDERS" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock DockPanel.Dock="Top" Text="Largest folders" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top" Text="Heaviest directories with file counts and risk before you change anything."
                         Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Largest folders appear after a scan"
                                   Description="A scan reveals the heaviest folders with file counts and risk guidance before you touch anything."
                                   Hint1="Folder sizes"/>
              <ListBox ItemsSource="{Binding LargestFolders}" Visibility="{Binding HasScanResult, Converter={StaticResource BoolVis}}" MouseDoubleClick="FolderList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="80"/>
                          <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding FileCount, StringFormat={}{0:N0}}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Risk}" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Cleanup -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Cleanup">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <TextBlock DockPanel.Dock="Top" Text="FREE SPACE" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock DockPanel.Dock="Top" Text="Safe cleanup suggestions" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top" Text="Every recommendation includes a reason. Protected items never appear as one-click deletes."
                         Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
              <ctrl:EmptyStateView DockPanel.Dock="Top" Margin="0,0,0,8"
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Cleanup suggestions need a scan"
                                   Description="SpaceLens suggests SAFE and REVIEW items only after analyzing your drives. Deletes always go through confirmation."
                                   Hint1="SAFE suggestions · Recycle Bin by default"/>
              <ctrl:EmptyStateView DockPanel.Dock="Top" Margin="0,0,0,8"
                                   Visibility="{Binding ShowCleanupEmpty, Converter={StaticResource BoolVis}}"
                                   ShowActions="False"
                                   Eyebrow="ALL CLEAR"
                                   Title="No cleanup suggestions right now"
                                   Description="This scan did not find SAFE or REVIEW candidates that match SpaceLens rules. Protected and unknown items stay out of one-click cleanup."
                                   Hint1="Try Downloads, Old files, or Development for manual review."/>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"
                          Visibility="{Binding HasCleanupItems, Converter={StaticResource BoolVis}}">
                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap">
                  <Run Text="Potential to free "/><Run Text="{Binding PotentialCleanupBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                  <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}"/>
                  <Run Text="SAFE " Foreground="{DynamicResource SafeBrush}"/><Run Text="{Binding SafeCleanupBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}" Foreground="{DynamicResource SafeBrush}"/>
                  <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}"/>
                  <Run Text="REVIEW " Foreground="{DynamicResource ReviewBrush}"/><Run Text="{Binding ReviewCleanupBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}" Foreground="{DynamicResource ReviewBrush}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Select all SAFE" Style="{StaticResource GhostButton}" Command="{Binding SelectAllSafeCommand}"
                          ToolTip="Select every SAFE recommendation" Margin="0,0,8,0"
                          AutomationProperties.Name="Select all SAFE"/>
                  <Button Content="Clear selection" Style="{StaticResource GhostButton}" Command="{Binding ClearCleanupSelectionCommand}"
                          ToolTip="Deselect all items" Margin="0,0,8,0"/>
                  <Button Content="Move to Recycle Bin" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCleanupCommand}"
                          ToolTip="Requires confirmation. Default safe cleanup action." Margin="0,0,8,0"
                          AutomationProperties.Name="Move to Recycle Bin"/>
                  <Button Content="Open Recycle Bin" Style="{StaticResource SecondaryButton}" Command="{Binding OpenRecycleBinCommand}"
                          ToolTip="Restore items in Windows Recycle Bin if needed"/>
                </StackPanel>
                <TextBlock Text="{Binding LastCleanupSummary}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding CleanupItems}" MouseDoubleClick="CleanupList_MouseDoubleClick"
                       Visibility="{Binding HasCleanupItems, Converter={StaticResource BoolVis}}"
                       AutomationProperties.Name="Cleanup suggestions">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Reason}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Risk}" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Duplicates -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Duplicates">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="LOOK CLOSER" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                <TextBlock Text="Duplicate files" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <TextBlock Text="Candidates matched by size and content hash. SpaceLens never chooses what to delete for you."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
              </StackPanel>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Duplicates need a scan"
                                   Description="Matching files are grouped by size and content hash. You decide what stays."
                                   Hint1="Hash-matched groups"/>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding ShowDuplicatesEmpty, Converter={StaticResource BoolVis}}"
                                   ShowActions="False"
                                   Eyebrow="NO MATCHES"
                                   Title="No duplicate groups found"
                                   Description="Nothing in this scan matched by size and content hash above your minimum size setting."
                                   Hint1="Lower the duplicate minimum in Settings if you want smaller files included."/>
              <ListBox ItemsSource="{Binding Duplicates}" Visibility="{Binding HasDuplicateGroups, Converter={StaticResource BoolVis}}"
                       AutomationProperties.Name="Duplicate groups">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold">
                          <Run Text="Group #"/><Run Text="{Binding GroupId, Mode=OneWay}"/>
                          <Run Text=" - Recoverable "/><Run Text="{Binding RecoverableBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Margin="0,3" FontFamily="{StaticResource MonoFont}" FontSize="13">
                                <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding FullPath, Mode=OneWay}"/>
                              </TextBlock>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Downloads -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Downloads">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="FREE SPACE" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock Text="Downloads" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock Text="Old installers, archives, and leftover downloads worth reviewing."
                         Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
              <ctrl:EmptyStateView Margin="0,0,0,8"
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Downloads analysis needs a scan"
                                   Description="Spot old installers, archives, and leftover downloads that are safe candidates to review."
                                   Hint1="Installers"/>
              <StackPanel Visibility="{Binding HasScanResult, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{Binding Result.Downloads.Path}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
              <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap">
                <Run Text="Total "/><Run Text="{Binding Result.Downloads.TotalBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
                <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}"/>
                <Run Text="Potential "/><Run Text="{Binding Result.Downloads.PotentialCleanupBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}"/>
                <Run Text="Installers "/><Run Text="{Binding Result.Downloads.InstallerBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
                <Run Text=" · Archives "/><Run Text="{Binding Result.Downloads.ArchiveBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
              </TextBlock>
              <ListBox ItemsSource="{Binding Result.Downloads.Items}" MouseDoubleClick="FileList_MouseDoubleClick" MaxHeight="420">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="6,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Category}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </StackPanel>
            </StackPanel>

            <!-- Development -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Development">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="LOOK CLOSER" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                <TextBlock Text="Development storage" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <TextBlock Text="Regeneratable artifacts are labeled REVIEW — never deleted automatically."
                           Style="{StaticResource MutedText}"/>
              </StackPanel>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Development folders need a scan"
                                   Description="node_modules, build outputs, and other regeneratable artifacts show up here with REVIEW guidance."
                                   Hint1="Build outputs"/>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding ShowDevEmpty, Converter={StaticResource BoolVis}}"
                                   ShowActions="False"
                                   Eyebrow="CLEAN"
                                   Title="No development artifacts found"
                                   Description="No node_modules, build caches, or similar regeneratable folders were detected in this scan."
                                   Hint1="Scan a project folder if your repos live off the system drive."/>
              <ListBox ItemsSource="{Binding DevArtifacts}" Visibility="{Binding HasDevArtifactsList, Converter={StaticResource BoolVis}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold">
                          <Run Text="{Binding ProjectName, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding ArtifactName, Mode=OneWay}"/>
                          <Run Text=" - "/><Run Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Reason}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13"/>
                        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource AccentBrush}" Text="{Binding Recommendation}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Applications -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Applications">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="LOOK CLOSER" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                <TextBlock Text="Application storage" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <TextBlock Text="Analysis only — SpaceLens does not uninstall applications."
                           Style="{StaticResource MutedText}"/>
              </StackPanel>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Application storage needs a scan"
                                   Description="See install, cache, and user-data estimates. SpaceLens never uninstalls apps for you."
                                   Hint1="Install size"/>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding ShowApplicationsEmpty, Converter={StaticResource BoolVis}}"
                                   ShowActions="False"
                                   Eyebrow="NONE FOUND"
                                   Title="No application footprints detected"
                                   Description="Heuristic path matching did not find install or cache folders in this scan."
                                   Hint1="SpaceLens analyzes storage — it does not uninstall apps."/>
              <ListBox ItemsSource="{Binding Applications}" Visibility="{Binding HasApplicationsList, Converter={StaticResource BoolVis}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold"/>
                          <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Install "/><Run Text="{Binding InstalledSizeBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
                            <Run Text=" - Cache "/><Run Text="{Binding CacheSizeBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
                            <Run Text=" - Data "/><Run Text="{Binding UserDataSizeBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
                          </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TotalBytes, Converter={StaticResource SizeFmt}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Old Files -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Old Files">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <TextBlock DockPanel.Dock="Top" Text="AGE" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock DockPanel.Dock="Top" Text="Files left untouched" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top" Text="Old does not mean delete. Review before you act."
                         Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Untouched files need a scan"
                                   Description="Filter by last-modified age to review stale files. Age alone never means delete."
                                   Hint1="Choose 30, 90, 180 days, or 1 year after scanning."/>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"
                          Visibility="{Binding HasScanResult, Converter={StaticResource BoolVis}}">
                <TextBlock Text="NOT MODIFIED IN" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                <ComboBox Width="180" HorizontalAlignment="Left" SelectedValue="{Binding SelectedAgeFilter}" SelectedValuePath="Tag"
                          AutomationProperties.Name="Age filter">
                  <ComboBoxItem Content="30 days" Tag="30"/>
                  <ComboBoxItem Content="90 days" Tag="90"/>
                  <ComboBoxItem Content="180 days" Tag="180" IsSelected="True"/>
                  <ComboBoxItem Content="1 year" Tag="365"/>
                </ComboBox>
              </StackPanel>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding ShowOldFilesEmpty, Converter={StaticResource BoolVis}}"
                                   ShowActions="False"
                                   Eyebrow="NONE IN RANGE"
                                   Title="No untouched files in this range"
                                   Description="Nothing matched the selected age filter in the last scan index."
                                   Hint1="Try a longer window, like 1 year."/>
              <ListBox ItemsSource="{Binding OldFiles}" MouseDoubleClick="FileList_MouseDoubleClick"
                       Visibility="{Binding HasOldFilesList, Converter={StaticResource BoolVis}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="100"/>
                          <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ModifiedUtc, StringFormat=Modified {0:d}}" VerticalAlignment="Center" FontSize="13"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Search -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Search">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <TextBlock DockPanel.Dock="Top" Text="FIND" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock DockPanel.Dock="Top" Text="Search" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Top" Text="Search files from your last scan. Nothing leaves this PC."
                         Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding HasScanResult, Converter={StaticResource BoolVisInv}}"
                                   Title="Search needs a scan index"
                                   Description="Run a scan first. SpaceLens searches files discovered in your last analysis - nothing leaves this PC."
                                   Hint1="Name search"/>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"
                          Visibility="{Binding HasScanResult, Converter={StaticResource BoolVis}}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource PrimaryButton}" Command="{Binding RunSearchCommand}"
                          ToolTip="Search indexed files from the last scan (Enter)" Margin="8,0,0,0" Width="100"
                          AutomationProperties.Name="Search"/>
                  <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Name, path fragment, or extension like .mp4"
                           AutomationProperties.Name="Search query"/>
                </DockPanel>
              </StackPanel>
              <ctrl:EmptyStateView DockPanel.Dock="Top"
                                   Visibility="{Binding ShowSearchEmpty, Converter={StaticResource BoolVis}}"
                                   ShowActions="False"
                                   Eyebrow="NO RESULTS"
                                   Title="Nothing matched"
                                   Description="No files in the last scan index matched that query. Try another name, path fragment, or extension."
                                   Hint1="Search only covers files discovered in your last scan."/>
              <ListBox ItemsSource="{Binding SearchResults}" MouseDoubleClick="FileList_MouseDoubleClick"
                       Visibility="{Binding HasSearchResults, Converter={StaticResource BoolVis}}"
                       AutomationProperties.Name="Search results">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="80"/>
                          <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding FullPath}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource SizeFmt}}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Category}" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Grid.Column="3" Text="{Binding Risk}" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- History -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="History">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="SEE" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock Text="Storage history" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock Text="Lightweight local snapshots only — no file contents stored."
                         Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
              <ctrl:EmptyStateView Margin="0,0,0,8"
                                   Visibility="{Binding HasHistory, Converter={StaticResource BoolVisInv}}"
                                   Title="No history yet"
                                   Description="Each completed scan saves a lightweight local snapshot so you can watch used space and cleanup potential over time."
                                   Hint1="Used space trend"/>
              <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource BoolVis}}">
              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <ctrl:HistoryLineChart Height="160" Points="{Binding HistoryPoints}"/>
              </Border>
              <ListBox ItemsSource="{Binding History}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,6">
                      <Run Text="{Binding TimestampUtc, StringFormat={}{0:g}, Mode=OneWay}"/>
                      <Run Text=" - Used "/><Run Text="{Binding UsedBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
                      <Run Text=" - Cleanup "/><Run Text="{Binding PotentialCleanupBytes, Converter={StaticResource SizeFmt}, Mode=OneWay}"/>
                    </TextBlock>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </StackPanel>
            </StackPanel>

            <!-- Settings -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="APP" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock Text="Preferences stay on this PC." Style="{StaticResource MutedText}" Margin="0,0,0,28"/>

              <TextBlock Text="APPEARANCE" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
              <DockPanel Margin="0,0,0,28" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,24,0">
                  <TextBlock Text="Theme" FontWeight="SemiBold"/>
                  <TextBlock Text="Switch between dark and light surfaces." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                  <RadioButton Content="Dark" GroupName="Theme" Style="{StaticResource ThemeSegmentFirst}"
                               IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                               Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                  <RadioButton Content="Light" GroupName="Theme" Style="{StaticResource ThemeSegmentLast}"
                               IsChecked="{Binding IsDarkTheme, Converter={StaticResource InvertBool}, Mode=OneWay}"
                               Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                </StackPanel>
              </DockPanel>

              <TextBlock Text="SCAN" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
              <TextBlock Text="Duplicate minimum size (bytes)" FontWeight="SemiBold"/>
              <TextBox Width="200" HorizontalAlignment="Left" Margin="0,8,0,16" Text="{Binding Settings.DuplicateMinSizeBytes}"/>
              <TextBlock Text="Scan parallelism" FontWeight="SemiBold"/>
              <TextBox Width="80" HorizontalAlignment="Left" Margin="0,8,0,16" Text="{Binding Settings.Parallelism}"/>
              <CheckBox Content="Enable scan history" IsChecked="{Binding Settings.EnableScanHistory}" Margin="0,0,0,28" Foreground="{DynamicResource TextPrimaryBrush}"/>

              <TextBlock Text="ACTIONS" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
              <Button Content="Save settings" Style="{StaticResource PrimaryButton}" ToolTip="Save scan preferences" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"
                      AutomationProperties.Name="Save settings"/>
              <Button Content="Run as administrator" Style="{StaticResource SecondaryButton}" ToolTip="Relaunch with UAC elevation for restricted folders" Command="{Binding RequestElevationCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
              <Button Content="Exit SpaceLens" Style="{StaticResource DangerButton}" Click="ExitApp_Click" HorizontalAlignment="Left" Margin="0,16,0,0"
                      ToolTip="Quit SpaceLens completely"
                      AutomationProperties.Name="Exit SpaceLens"/>
              <TextBlock Text="{Binding AppVersionLabel}" Style="{StaticResource CaptionText}" Margin="0,28,0,0"/>
              <TextBlock Text="Minimize keeps SpaceLens on the taskbar. Close (X) or Exit quits the app."
                         Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Privacy -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="Privacy">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="APP" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock Text="Privacy" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock Text="SpaceLens is local-first. Scans and history stay on this machine."
                         Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
              <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                  <TextBlock Text="Your files stay on your computer. Storage analysis is performed locally." FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="SpaceLens does not upload file metadata, document contents, or paths to external servers. There is no cloud processing, no telemetry by default, and no external API requirement for core scanning. Scan history stores only lightweight statistics (sizes and category totals), not file contents."/>
                </StackPanel>
              </Border>
              <TextBlock Text="LOCAL DATA" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
              <TextBlock Text="Settings and history live under %LocalAppData%\SpaceLens."
                         Style="{StaticResource CaptionText}" Margin="0,0,0,12" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Open data folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDataFolderCommand}"
                        ToolTip="Open the local SpaceLens data directory" Margin="0,0,10,0"
                        AutomationProperties.Name="Open data folder"/>
                <Button Content="Clear scan history" Style="{StaticResource GhostButton}" Command="{Binding ClearScanHistoryCommand}"
                        ToolTip="Remove local history snapshots only"
                        AutomationProperties.Name="Clear scan history"/>
              </StackPanel>
            </StackPanel>

            <!-- About -->
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentPage}" Value="About">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="APP" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
              <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock Text="Understand your storage. Clean it safely."
                         Style="{StaticResource MutedText}" Margin="0,0,0,24"/>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Image Source="Assets/logo.png" Width="72" Height="72" Margin="0,0,20,0"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource UiDisplay}">
                    <Run Text="Space" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Run Text="Lens" Foreground="{DynamicResource AccentBrush}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding AppVersionLabel}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                  <TextBlock Text="Windows storage analyzer" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                </StackPanel>
              </StackPanel>

              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="WHAT IT DOES" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="22"
                             Text="Scans local drives, explains what is using space, classifies files with a transparent SAFE / REVIEW / PROTECTED engine, and only deletes after you confirm. Default action is Recycle Bin."/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="LICENSE" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="22"
                             Text="SpaceLens is released under the MIT License. It uses CommunityToolkit.Mvvm (MIT). See LICENSE in the product folder for the full text."/>
                </StackPanel>
              </Border>

              <TextBlock Text="Minimize keeps the app on the taskbar. Close (X) exits SpaceLens."
                         Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
        </Border>
      </Grid>

      <!-- Details panel -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16"
              Width="300" Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}">
        <ScrollViewer VerticalScrollBarVisibility="Visible">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource GhostButton}" Padding="8,4"
                      Click="CloseDetail_Click" ToolTip="Close details"/>
              <TextBlock Text="Details" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DetailSize}" FontSize="22" Margin="0,8,0,4" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{Binding DetailPath}" FontSize="13" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
            <TextBlock>
              <Run Text="Category: "/><Run Text="{Binding DetailCategory, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{Binding DetailRisk, Converter={StaticResource RiskBrush}}">
              <Run Text="Risk: "/><Run Text="{Binding DetailRisk, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding DetailMeta}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="Why" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding DetailReason}" TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="Recommended action" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding DetailAction}" TextWrapping="Wrap" Margin="0,4,0,16"/>
            <TextBlock Text="{Binding ExplanationText}" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="Actions" FontWeight="SemiBold" Margin="0,4,0,8"/>
            <Button Content="Open" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFileCommand}"
                    ToolTip="Open this file with the default app" Margin="0,0,0,8"/>
            <Button Content="Open folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenPathCommand}"
                    ToolTip="Show in File Explorer" Margin="0,0,0,8"/>
            <Button Content="Copy path" Style="{StaticResource GhostButton}" Command="{Binding CopyPathCommand}"
                    ToolTip="Copy full path to clipboard" Margin="0,0,0,8"/>
            <Button Content="Move to Recycle Bin" Style="{StaticResource PrimaryButton}" Command="{Binding MoveDetailToRecycleBinCommand}"
                    ToolTip="Safe delete - can restore from Recycle Bin" Margin="0,12,0,8"/>
            <Button Content="Delete permanently..." Style="{StaticResource DangerButton}" Command="{Binding DeleteDetailPermanentlyCommand}"
                    ToolTip="Cannot be undone from SpaceLens"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
